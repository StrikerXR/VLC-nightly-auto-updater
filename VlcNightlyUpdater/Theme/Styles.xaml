<!--
  SHARED STYLES built from Tokens.xaml. Views use these instead of styling controls by hand:
    VnuCard   rounded surface for every panel and tile
    VnuLabel  small muted caption (section labels, hints, meta lines)
    VnuMono   monospace value (build numbers)
    VnuDivider thin separator line
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="VnuCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VnuCardRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="VnuLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="{StaticResource VnuSubtleOpacity}" />
    </Style>

    <Style x:Key="VnuMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="VnuDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
