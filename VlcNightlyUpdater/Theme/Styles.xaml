<!--
  SHARED STYLES built from Tokens.xaml. Views use these instead of styling controls by hand:
    VnuCard   rounded surface for every panel and tile
    VnuLabel  small muted caption (section labels, hints, meta lines)
    VnuMono   monospace value (build numbers)
    VnuDivider thin separator line
    VnuSectionTitle  heading above a group of cards
    VnuIconChip      tinted rounded square that holds a glyph (tiles, settings rows)
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Theme/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="VnuCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource VnuCardRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="VnuLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="{StaticResource VnuSubtleOpacity}" />
    </Style>

    <Style x:Key="VnuMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Small uppercase-free section heading above a group of cards (Settings) -->
    <Style x:Key="VnuSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="Margin" Value="4,6,0,-4" />
    </Style>

    <!-- Rounded square behind a small glyph; the brand tint follows the chosen accent color -->
    <Style x:Key="VnuIconChip" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{StaticResource VnuBrandTintBrush}" />
    </Style>

    <Style x:Key="VnuDivider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
