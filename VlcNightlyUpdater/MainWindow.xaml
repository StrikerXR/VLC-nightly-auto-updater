<Window
    x:Class="VlcNightlyUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VlcNightlyUpdater"
    Title="VLC Nightly Updater">

    <Window.SystemBackdrop>
        <!-- Mica Alt that keeps its colours when the window loses focus -->
        <local:AlwaysActiveMicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title area (drag region). Native min/close buttons overlay on the right. -->
        <Grid x:Name="TitleBarArea" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Same artwork as the app icon: orange gradient tile + rounded-cap download arrow -->
                <Border Width="22" Height="22" CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFB040" Offset="0" />
                            <GradientStop Color="#FFFF6A00" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Canvas Width="22" Height="22">
                        <Path Stroke="White" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 11,4.5 L 11,12.8 M 7.2,9.2 L 11,13 L 14.8,9.2 M 6.8,16.6 L 15.2,16.6" />
                    </Canvas>
                </Border>
                <TextBlock Text="VLC Nightly Updater" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" Opacity="0.5" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="12">

            <!-- Shown when a newer updater exists and automatic self-update is off (or failed) -->
            <InfoBar x:Name="SelfUpdateBar" IsOpen="False" IsClosable="False" Severity="Informational"
                     Title="Updater update available" Message="">
                <InfoBar.ActionButton>
                    <Button x:Name="SelfUpdateButton" Content="Update now" Click="SelfUpdateButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Status card -->
            <Border x:Name="StatusCard" Style="{StaticResource CardBorder}" Padding="20">
                <Grid ColumnSpacing="16" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Badge: a ProgressRing orbits it while something is happening -->
                    <Grid Width="58" Height="58" VerticalAlignment="Top">
                        <ProgressRing x:Name="BusyRing" Width="58" Height="58"
                                      IsActive="False" Foreground="#FFFF8800" />
                        <Grid x:Name="BadgeHost" Width="48" Height="48">
                            <Border x:Name="IconBadge" CornerRadius="24" Background="#33FF8800" />
                            <FontIcon x:Name="StatusIcon" Glyph="&#xE895;" FontSize="22" Foreground="#FFFF8800"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- Hand-drawn glyphs so they sit exactly in the middle of the circle -->
                            <Canvas Width="48" Height="48">
                                <Path x:Name="CheckPath" Visibility="Collapsed" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      StrokeDashArray="10,10" Stroke="#FF6CCB5F"
                                      Data="M 14.5,24.5 L 21.5,31.5 L 33.5,17.5" />
                                <Path x:Name="CrossPath" Visibility="Collapsed" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      StrokeDashArray="10,10" Stroke="#FFFF6B6B"
                                      Data="M 17,17 L 31,31 M 31,17 L 17,31" />
                            </Canvas>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" Text="Starting…" />
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Opacity="0.7"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DownloadBar" VerticalAlignment="Center"
                                     Minimum="0" Maximum="100" Foreground="#FFFF8800" IsIndeterminate="True" />
                        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Visibility="Collapsed"
                                Click="CancelButton_Click" />
                    </Grid>
                </Grid>
            </Border>

            </StackPanel>

            <!-- Build tiles -->
            <Grid x:Name="TilesGrid" Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="INSTALLED BUILD" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock x:Name="InstalledText" Text="—" FontFamily="Consolas" FontSize="16" />
                        <TextBlock x:Name="InstalledDate" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LATEST NIGHTLY" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock x:Name="LatestText" Text="—" FontFamily="Consolas" FontSize="16" />
                        <TextBlock x:Name="LatestDate" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Options: one Expander per topic -->
            <ScrollViewer x:Name="OptionsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="0,0,12,0">

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                            <FontIcon Glyph="&#xE72C;" FontSize="15" />
                            <TextBlock Text="Updating" VerticalAlignment="Center" />
                        </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Update automatically when opened" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="AutoToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="Option_Toggled" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Launch VLC after updating" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="LaunchToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="Option_Toggled" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Close this updater after updating" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="CloseToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="Option_Toggled" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Reopen VLC afterwards if it was running" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="ReopenToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="Option_Toggled" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Keep this updater up to date automatically" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="SelfToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="Option_Toggled" />
                        </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                            <FontIcon Glyph="&#xE823;" FontSize="15" />
                            <TextBlock Text="Pause VLC updates" VerticalAlignment="Center" />
                            <InfoBadge x:Name="PauseBadge" Style="{StaticResource AttentionDotInfoBadgeStyle}"
                                       Visibility="Collapsed" VerticalAlignment="Top" />
                        </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                            <TextBlock Text="Hold off on installs and notifications until a date you pick."
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:Name="PauseDate" PlaceholderText="Pause until…"
                                                    HorizontalAlignment="Stretch" DateChanged="PauseDate_DateChanged" />
                                <DropDownButton Grid.Column="1" Content="Quick pick">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Tomorrow" Tag="1" Click="PausePreset_Click" />
                                            <MenuFlyoutItem Text="3 days" Tag="3" Click="PausePreset_Click" />
                                            <MenuFlyoutItem Text="1 week" Tag="7" Click="PausePreset_Click" />
                                            <MenuFlyoutItem Text="2 weeks" Tag="14" Click="PausePreset_Click" />
                                            <MenuFlyoutItem Text="1 month" Tag="30" Click="PausePreset_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button x:Name="PauseClearButton" Grid.Column="2" Content="Resume" Click="PauseClear_Click" />
                            </Grid>
                            <TextBlock x:Name="PauseNote" TextWrapping="Wrap" Opacity="0.7"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                            <FontIcon Glyph="&#xEA8F;" FontSize="15" />
                            <TextBlock Text="Notifications" VerticalAlignment="Center" />
                        </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Check for VLC updates in the background" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="BackgroundToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="BackgroundToggle_Toggled" />
                        </Grid>
                            <TextBlock x:Name="BackgroundNote" TextWrapping="Wrap" Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BackgroundLast" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <Button x:Name="TestNotifyButton" Grid.Column="1" Content="Send test notification"
                                        Click="TestNotifyButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                            <FontIcon Glyph="&#xE7B8;" FontSize="15" />
                            <TextBlock Text="Builds &amp; cache" VerticalAlignment="Center" />
                        </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                            <TextBlock Text="VLC build (64-bit / ARM64)"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <ComboBox x:Name="ArchPicker" HorizontalAlignment="Stretch"
                                      SelectionChanged="ArchPicker_SelectionChanged" />

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <TextBlock Text="Install a specific build (rollback or reinstall)"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="BuildPicker" HorizontalAlignment="Stretch" DisplayMemberPath="Label"
                                          PlaceholderText="Pick a build…" SelectionChanged="BuildPicker_SelectionChanged" />
                                <Button x:Name="InstallSelectedButton" Grid.Column="1" Content="Install"
                                        IsEnabled="False" Click="InstallSelectedButton_Click" />
                            </Grid>

                            <Grid>
                                <TextBlock Text="Keep installers for offline rollback" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                                <ToggleSwitch x:Name="CacheToggle" HorizontalAlignment="Right" MinWidth="0"
                                              OnContent="" OffContent="" Toggled="CacheToggle_Toggled" />
                            </Grid>
                            <Grid x:Name="CachePanel" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="CacheText" Opacity="0.6"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <ProgressBar x:Name="CacheBar" Minimum="0" Maximum="3" Value="0" Foreground="#FFFF8800" />
                                </StackPanel>
                                <Button x:Name="ClearCacheButton" Grid.Column="1" Content="Clear cache"
                                        Click="ClearCacheButton_Click" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <TextBlock Text="Leave the nightly channel"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Button x:Name="GoStableButton" HorizontalAlignment="Stretch" Click="GoStableButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                    <TextBlock Text="Go back to stable" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Installs the latest stable VLC. This updater only handles nightlies, so it pauses until you switch back."
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>

                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,2">
                            <FontIcon Glyph="&#xE945;" FontSize="15" />
                            <TextBlock Text="AI change summary" VerticalAlignment="Center" />
                        </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Summarize changes with Gemini" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,64,0" />
                            <ToggleSwitch x:Name="AiToggle" HorizontalAlignment="Right" MinWidth="0"
                                          OnContent="" OffContent="" Toggled="AiToggle_Toggled" />
                        </Grid>
                            <TextBlock x:Name="AiNote" TextWrapping="Wrap" Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <StackPanel x:Name="AiPanel" Spacing="8" Visibility="Collapsed">
                                <PasswordBox x:Name="AiKeyBox" Header="Gemini API key" PlaceholderText="Paste your key"
                                             LostFocus="AiFields_LostFocus" />
                                <TextBox x:Name="AiModelBox" Header="Model" LostFocus="AiFields_LostFocus" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- What changed (full width so it never gets cut off) -->
            <HyperlinkButton x:Name="ChangesButton" Grid.Row="3" Padding="2,4" Visibility="Collapsed"
                             HorizontalAlignment="Left" Click="ChangesButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                    <TextBlock x:Name="ChangesLabel" TextWrapping="Wrap" />
                </StackPanel>
            </HyperlinkButton>

            <!-- Actions -->
            <Grid x:Name="ActionsRow" Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LastCheckedText" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ConfigButton" Click="ConfigButton_Click"
                            ToolTipService.ToolTip="Open VLC settings folder">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                    </Button>
                    <Button x:Name="LaunchButton" Click="LaunchButton_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Launch VLC" />
                        </StackPanel>
                    </Button>
                    <Grid>
                        <Button x:Name="PrimaryButton" Click="PrimaryButton_Click" IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="PrimaryIcon" Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock x:Name="PrimaryText" Text="Check again" />
                            </StackPanel>
                        </Button>
                        <InfoBadge x:Name="UpdateBadge" Style="{StaticResource AttentionDotInfoBadgeStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                   Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
