<Window
    x:Class="VlcNightlyUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VlcNightlyUpdater.Views">

    <!--
      THE SHELL. Layout only: every block below is its own file in Views/.
      Window title and size come from AppConfig (set in MainWindow.Chrome.cs).
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title area (drag region). Native min/close buttons overlay on the right. -->
        <Grid x:Name="TitleBarArea" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="{StaticResource VnuChipRadius}"
                        Background="{StaticResource VnuBrandBrush}">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource VnuOnBrandBrush}" />
                </Border>
                <TextBlock Text="VLC Nightly Updater" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" Opacity="0.5" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- banner + status -->
                <RowDefinition Height="Auto" /> <!-- tiles -->
                <RowDefinition Height="Auto" /> <!-- tab strip -->
                <RowDefinition Height="*" />    <!-- the selected tab -->
                <RowDefinition Height="Auto" /> <!-- actions -->
            </Grid.RowDefinitions>

            <StackPanel Spacing="12">
                <!-- Shown when a newer updater exists and automatic self-update is off (or failed) -->
                <InfoBar x:Name="SelfUpdateBar" IsOpen="False" IsClosable="False" Severity="Informational"
                         Title="Updater update available" Message="">
                    <InfoBar.ActionButton>
                        <Button x:Name="SelfUpdateButton" Content="Update now" Click="SelfUpdateButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <v:StatusCard x:Name="Status" />
            </StackPanel>

            <v:BuildTiles x:Name="Tiles" Grid.Row="1" />

            <SelectorBar x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem Text="Changes" IsSelected="True" />
                <SelectorBarItem Text="Settings" />
                <SelectorBarItem Text="Builds" />
            </SelectorBar>

            <!-- One panel visible at a time (see Tabs_SelectionChanged). Add a tab = SelectorBarItem + panel + one case. -->
            <Grid Grid.Row="3">
                <v:ChangesPanel x:Name="Changes" />
                <v:SettingsPanel x:Name="Settings" Visibility="Collapsed" />
                <v:BuildsPanel x:Name="Builds" Visibility="Collapsed" />
            </Grid>

            <v:ActionBar x:Name="Actions" Grid.Row="4" />
        </Grid>
    </Grid>
</Window>
