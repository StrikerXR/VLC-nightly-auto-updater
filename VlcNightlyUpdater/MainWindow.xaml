<Window
    x:Class="VlcNightlyUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VLC Nightly Updater">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title area (drag region). Native min/close buttons overlay on the right. -->
        <Grid x:Name="TitleBarArea" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="#FF8800">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="White" />
                </Border>
                <TextBlock Text="VLC Nightly Updater" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,24" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status card -->
            <Border Style="{StaticResource CardBorder}" Padding="20">
                <Grid ColumnSpacing="16" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="IconBadge" Width="52" Height="52" CornerRadius="26"
                            Background="#33FF8800" VerticalAlignment="Top">
                        <FontIcon x:Name="StatusIcon" Glyph="&#xE895;" FontSize="24" Foreground="#FF8800" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" Text="Starting…" />
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Opacity="0.7"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <ProgressBar x:Name="DownloadBar" Grid.Row="1" Grid.ColumnSpan="2"
                                 Minimum="0" Maximum="100" Foreground="#FF8800" IsIndeterminate="True" />
                </Grid>
            </Border>

            <!-- Build tiles -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="INSTALLED BUILD" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock x:Name="InstalledText" Text="—" FontFamily="Consolas" FontSize="16" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LATEST NIGHTLY" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                        <TextBlock x:Name="LatestText" Text="—" FontFamily="Consolas" FontSize="16" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="LaunchButton" Click="LaunchButton_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="Launch VLC" />
                    </StackPanel>
                </Button>
                <Button x:Name="CheckButton" Click="CheckButton_Click" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Check again" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
