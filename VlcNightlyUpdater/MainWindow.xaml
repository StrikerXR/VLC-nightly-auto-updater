<Window
    x:Class="VlcNightlyUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VLC Nightly Updater">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="VLC Nightly Updater" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock x:Name="StatusText" Grid.Row="1" TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}" Text="Starting…" />

        <ProgressBar x:Name="DownloadBar" Grid.Row="2" Minimum="0" Maximum="100" IsIndeterminate="True" />

        <TextBlock x:Name="DetailText" Grid.Row="3" TextWrapping="Wrap" Opacity="0.7" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CheckButton" Content="Check again" Click="CheckButton_Click" IsEnabled="False" />
            <Button x:Name="LaunchButton" Content="Launch VLC" Click="LaunchButton_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
