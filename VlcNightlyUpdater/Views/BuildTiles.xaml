<UserControl
    x:Class="VlcNightlyUpdater.Views.BuildTiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VlcNightlyUpdater.Views">

    <!-- Three tiles: what you have, what's out, how far behind you are. Add a tile = add a column + a Tile. -->
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0.7*" />
        </Grid.ColumnDefinitions>
        <v:Tile x:Name="Installed" Label="INSTALLED BUILD" />
        <v:Tile x:Name="Latest" Grid.Column="1" Label="LATEST NIGHTLY" />
        <v:Tile x:Name="Behind" Grid.Column="2" Label="BEHIND" />
    </Grid>
</UserControl>
