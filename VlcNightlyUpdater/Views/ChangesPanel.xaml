<UserControl
    x:Class="VlcNightlyUpdater.Views.ChangesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Changes tab: the VLC commits between two nightlies (loaded automatically after each check), with a filter. -->
    <Border Style="{StaticResource VnuCard}" Padding="16,12">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubText" Style="{StaticResource VnuLabel}" TextWrapping="Wrap" />
                </StackPanel>
                <HyperlinkButton x:Name="GitLabLink" Grid.Column="1" Content="Open on GitLab"
                                 VerticalAlignment="Top" Visibility="Collapsed" />
            </Grid>

            <!-- Filter: shown only while a commit list is on screen. Logic lives in Services/CommitFilter.cs. -->
            <Grid x:Name="FilterBar" Grid.Row="1" ColumnSpacing="12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" PlaceholderText="Filter by text or author…"
                         TextChanged="FilterBox_TextChanged" />
                <HyperlinkButton x:Name="CopyListLink" Grid.Column="2" Content="Copy list" Click="CopyListLink_Click"
                                 ToolTipService.ToolTip="Copies the commits shown (ID and title) to the clipboard" />
                <CheckBox x:Name="NoiseCheck" Grid.Column="1" Content="Hide merges and translations" MinWidth="0"
                          Checked="NoiseCheck_Changed" Unchecked="NoiseCheck_Changed" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CommitList" Spacing="10" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
