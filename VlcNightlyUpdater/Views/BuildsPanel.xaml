<UserControl
    x:Class="VlcNightlyUpdater.Views.BuildsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Builds tab: install an older/specific nightly (rollback or reinstall) and manage the offline cache. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <Border Style="{StaticResource VnuCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Install a specific build (rollback or reinstall)" Style="{StaticResource VnuLabel}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="BuildPicker" HorizontalAlignment="Stretch" DisplayMemberPath="Label"
                                  PlaceholderText="Pick a build…" SelectionChanged="BuildPicker_SelectionChanged" />
                        <Button x:Name="InstallButton" Grid.Column="1" Content="Install" IsEnabled="False"
                                Click="InstallButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource VnuCard}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CacheText" VerticalAlignment="Center" Style="{StaticResource VnuLabel}" />
                    <Button x:Name="ClearButton" Grid.Column="1" Content="Clear cache" Click="ClearButton_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
