<UserControl
    x:Class="VlcNightlyUpdater.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:VlcNightlyUpdater.Views">

    <!-- Settings tab. One ToggleRow per boolean in AppState; wiring lives in SettingsPanel.xaml.cs. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <Border Style="{StaticResource VnuCard}">
                <StackPanel Spacing="14">
                    <v:ToggleRow x:Name="AutoRow" Title="Update VLC automatically"
                                 Hint="Installs a new nightly as soon as this app opens." />
                    <v:ToggleRow x:Name="LaunchRow" Title="Open VLC after updating" />

                    <Rectangle Style="{StaticResource VnuDivider}" />

                    <v:ToggleRow x:Name="SelfRow" Title="Keep this updater up to date" />
                    <v:ToggleRow x:Name="PreRow" Title="Include pre-releases"
                                 Hint="Updater only. Gets whichever version is newest, even if it is a pre-release." />

                    <Rectangle Style="{StaticResource VnuDivider}" />

                    <v:ToggleRow x:Name="BgRow" Title="Notify me about new nightlies" />
                </StackPanel>
            </Border>

            <!-- Accent color selection -->
            <Border Style="{StaticResource VnuCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Accent color" Style="{StaticResource VnuLabel}" />
                    <ComboBox x:Name="AccentPicker" HorizontalAlignment="Stretch"
                              SelectionChanged="AccentPicker_SelectionChanged" />
                </StackPanel>
            </Border>

            <!-- Only shown on ARM64 PCs, where there are two VLC builds to choose from. -->
            <Border x:Name="ArchCard" Style="{StaticResource VnuCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="VLC build" Style="{StaticResource VnuLabel}" />
                    <ComboBox x:Name="ArchPicker" HorizontalAlignment="Stretch"
                              SelectionChanged="ArchPicker_SelectionChanged" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <HyperlinkButton x:Name="RepoLink" Content="GitHub" />
                <HyperlinkButton x:Name="ReleasesLink" Content="Releases" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
