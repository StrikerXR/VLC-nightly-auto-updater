<UserControl
    x:Class="VlcNightlyUpdater.Views.ActionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bottom bar: last-checked text on the left; folder / Launch VLC / main action on the right. -->
    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LastCheckedText" VerticalAlignment="Center" Style="{StaticResource VnuLabel}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Click="ConfigButton_Click" ToolTipService.ToolTip="Open VLC settings folder">
                <FontIcon Glyph="&#xE838;" FontSize="14" />
            </Button>
            <Button x:Name="LaunchButton" Click="LaunchButton_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Launch VLC" />
                </StackPanel>
            </Button>
            <Button x:Name="PrimaryButton" Click="PrimaryButton_Click" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PrimaryIcon" Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Name="PrimaryText" Text="Check again" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
