<ContentDialog
    x:Class="VlcNightlyUpdater.Views.WhatsNewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The full "What's new" dialog: logo + headline + version range on top, the changelog below (scrolls inside).
      Used before updating this updater (notes from the GitHub release) and once after it was updated (bundled notes).
      Text, buttons and notes are set from WhatsNewDialog.xaml.cs; wording lives in Config/Strings.cs.
    -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">780</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="18" MinWidth="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="Logo" Width="64" Height="64" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="HeadingText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <Border x:Name="RangeChip" HorizontalAlignment="Left" Padding="10,3" CornerRadius="12"
                        Background="{StaticResource VnuBrandTintBrush}">
                    <TextBlock x:Name="RangeText" Style="{StaticResource VnuMono}" FontSize="13"
                               Foreground="{StaticResource VnuBrandBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource VnuCard}" Padding="4">
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Padding="14,10,18,14">
                <ContentControl x:Name="NotesHost" HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
        </Border>
    </Grid>
</ContentDialog>
