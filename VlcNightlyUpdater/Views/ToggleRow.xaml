<UserControl
    x:Class="VlcNightlyUpdater.Views.ToggleRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One settings row: title (+ optional hint) on the left, switch on the right. -->
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" Style="{StaticResource VnuLabel}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <ToggleSwitch x:Name="Switch" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="Switch_Toggled" />
    </Grid>
</UserControl>
