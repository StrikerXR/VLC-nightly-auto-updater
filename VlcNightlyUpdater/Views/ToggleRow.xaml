<UserControl
    x:Class="VlcNightlyUpdater.Views.ToggleRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One settings row: optional icon chip, title (+ optional hint) in the middle, switch on the right. -->
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="IconChip" Style="{StaticResource VnuIconChip}" Visibility="Collapsed" VerticalAlignment="Center">
            <FontIcon x:Name="GlyphIcon" FontSize="15" Foreground="{StaticResource VnuBrandBrush}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" Style="{StaticResource VnuLabel}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <ToggleSwitch x:Name="Switch" Grid.Column="2" MinWidth="0" OnContent="" OffContent="" Toggled="Switch_Toggled" />
    </Grid>
</UserControl>
