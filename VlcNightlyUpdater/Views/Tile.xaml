<UserControl
    x:Class="VlcNightlyUpdater.Views.Tile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One small stat card: icon chip, LABEL, big mono value, muted sub line. -->
    <Border Style="{StaticResource VnuCard}" Padding="14,12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource VnuIconChip}" Width="30" Height="30" VerticalAlignment="Top">
                <FontIcon x:Name="GlyphIcon" Glyph="&#xE74C;" FontSize="14" Foreground="{StaticResource VnuBrandBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="LabelText" Style="{StaticResource VnuLabel}" CharacterSpacing="40" />
                <TextBlock x:Name="ValueText" Style="{StaticResource VnuMono}" FontWeight="SemiBold" Text="—" />
                <TextBlock x:Name="SubText" Style="{StaticResource VnuLabel}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
